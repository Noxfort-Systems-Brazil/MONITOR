# Noxfort Monitor™ - Access and Security Configuration (Example)
# Copy this file to .env before starting in production:
# cp .env.example .env
# chmod 600 .env

# --- Administrative Superuser Credentials ---
# SET STRONG CREDENTIALS IN PRODUCTION! (Minimum 8 characters, numbers, uppercase, lowercase, and symbols)
MONITOR_ADMIN_USER=admin
MONITOR_ADMIN_PASSWORD=YourStrongPassword@2026_Admin

# --- MQTT Authentication (Mosquitto) ---
# Configure the broker with: make broker-auth
MQTT_USER=noxfort_user
MQTT_PASSWORD=change_me_super_secret_mqtt_pass

# --- Caddy Reverse Proxy & DuckDNS (Automatic HTTPS) ---
# DuckDNS subdomain created at duckdns.org (name only, without .duckdns.org)
DUCKDNS_DOMAIN=
# Your DuckDNS account token
DUCKDNS_TOKEN=
# Email for ACME Let's Encrypt / ZeroSSL certificate expiration alerts
ACME_EMAIL=admin@noxfort.local
# Enables generation of public HTTPS URL (https://<subdomain>.duckdns.org)
MONITOR_USE_HTTPS=true
