# Noxfort Monitor™ - Configurações de Acesso e Segurança (Exemplo)
# Copie este arquivo para .env antes de iniciar em produção:
# cp .env.example .env
# chmod 600 .env

# --- Credenciais do Superusuário Administrativo ---
# DEFINA CREDENCIAIS FORTES EM PRODUÇÃO!
MONITOR_ADMIN_USER=admin
MONITOR_ADMIN_PASSWORD=change_me_super_secret_admin_pass

# --- Autenticação MQTT (Mosquitto) ---
# Configure o broker com: make broker-auth
MQTT_USER=noxfort_user
MQTT_PASSWORD=change_me_super_secret_mqtt_pass

# --- Caddy Reverse Proxy & DuckDNS (HTTPS Automático) ---
# Subdomínio DuckDNS criado em duckdns.org (apenas o nome, sem .duckdns.org)
DUCKDNS_DOMAIN=
# Token da sua conta DuckDNS
DUCKDNS_TOKEN=
# Email para notificações de expiração do certificado ACME Let's Encrypt / ZeroSSL
ACME_EMAIL=admin@noxfort.local
# Habilita geração de URL pública HTTPS (https://<subdominio>.duckdns.org)
MONITOR_USE_HTTPS=true
